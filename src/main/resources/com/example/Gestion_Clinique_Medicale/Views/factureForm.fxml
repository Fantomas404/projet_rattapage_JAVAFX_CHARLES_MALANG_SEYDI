<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" prefWidth="450.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.Gestion_Clinique_Medicale.Controller.FactureFormController">
    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>

    <Label text="Générer une Facture"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

    <Label text="Consultation :"/>
    <ComboBox fx:id="consultationCombo" prefWidth="410.0"
              promptText="Sélectionner une consultation"/>

    <Label text="Montant Total (DA) :"/>
    <TextField fx:id="montantField" promptText="ex: 2500.00"/>

    <Label text="Mode de Paiement :"/>
    <ComboBox fx:id="modePaiementCombo" prefWidth="410.0"
              promptText="Sélectionner le mode de paiement"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#annuler" style="-fx-padding: 8 20;"/>
        <Button text="Générer Facture" onAction="#enregistrer"
                style="-fx-background-color: #27AE60; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 20;"/>
    </HBox>
</VBox>