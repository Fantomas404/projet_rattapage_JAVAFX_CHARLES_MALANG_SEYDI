<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="14.0" prefWidth="520.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.Gestion_Clinique_Medicale.Controller.ConsultationFormController"
      style="-fx-background-color: #f0f7ff;">
    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>

    <Label text="Enregistrer une Consultation"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>

    <Separator style="-fx-background-color: #bfdbfe;"/>

    <VBox spacing="5.0">
        <Label text="Rendez-vous *"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <ComboBox fx:id="rdvCombo" prefWidth="472.0"
                  promptText="Sélectionner un rendez-vous"
                  onAction="#onRdvSelectionne"
                  style="-fx-background-color: white;
                         -fx-border-color: #bfdbfe;
                         -fx-border-radius: 6;
                         -fx-background-radius: 6;"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Médecin"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextField fx:id="medecinField"
                   promptText="Sélectionnez un rendez-vous..."
                   editable="false"
                   prefWidth="472.0"
                   style="-fx-background-color: #e8f0fe;
                          -fx-border-color: #bfdbfe;
                          -fx-border-radius: 6;
                          -fx-background-radius: 6;
                          -fx-padding: 8 12;
                          -fx-font-size: 13px;
                          -fx-text-fill: #1e3a5f;"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Diagnostic *"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextArea fx:id="diagnosticArea" prefHeight="80.0" prefWidth="472.0"
                  promptText="Entrez le diagnostic..."
                  style="-fx-background-color: white;
                         -fx-border-color: #bfdbfe;
                         -fx-border-radius: 6;
                         -fx-background-radius: 6;
                         -fx-font-size: 13px;"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Observations"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextArea fx:id="observationsArea" prefHeight="80.0" prefWidth="472.0"
                  promptText="Entrez les observations..."
                  style="-fx-background-color: white;
                         -fx-border-color: #bfdbfe;
                         -fx-border-radius: 6;
                         -fx-background-radius: 6;
                         -fx-font-size: 13px;"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Prescription"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextArea fx:id="prescriptionArea" prefHeight="80.0" prefWidth="472.0"
                  promptText="Entrez la prescription..."
                  style="-fx-background-color: white;
                         -fx-border-color: #bfdbfe;
                         -fx-border-radius: 6;
                         -fx-background-radius: 6;
                         -fx-font-size: 13px;"/>
    </VBox>

    <Label fx:id="errorLabel" text=""
           style="-fx-text-fill: #c53030; -fx-font-size: 12px;"
           wrapText="true"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
        <Button text="Annuler" onAction="#annuler"
                style="-fx-background-color: white;
                       -fx-border-color: #bfdbfe;
                       -fx-border-radius: 6;
                       -fx-background-radius: 6;
                       -fx-padding: 8 20;
                       -fx-cursor: hand;
                       -fx-text-fill: #334155;"/>
        <Button text="Enregistrer" onAction="#enregistrer"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 8 20;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>