<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Gestion_Clinique_Medicale.Controller.AccueilController">
    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>

    <VBox spacing="4.0">
        <Label fx:id="lblBienvenue" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;" />
        <Label fx:id="lblDate" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
    </VBox>

    <HBox spacing="16.0">

        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12;                      -fx-padding: 20; -fx-border-color: #bfdbfe;                      -fx-border-radius: 12; -fx-border-width: 1;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0">
                    <Label fx:id="lblNbPatients" style="-fx-font-size: 30px; -fx-font-weight: bold;                                   -fx-text-fill: #1e3a5f;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Patients" />
                </VBox>
            </HBox>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Total enregistres" />
        </VBox>

        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12;                      -fx-padding: 20; -fx-border-color: #bbf7d0;                      -fx-border-radius: 12; -fx-border-width: 1;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0">
                    <Label fx:id="lblNbRdv" style="-fx-font-size: 30px; -fx-font-weight: bold;                                   -fx-text-fill: #1e3a5f;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Rendez-vous">
                  <font>
                     <Font size="26.0" />
                  </font></Label>
                </VBox>
            </HBox>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Aujourd'hui" textAlignment="CENTER" />
        </VBox>

        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12;                      -fx-padding: 20; -fx-border-color: #fde68a;                      -fx-border-radius: 12; -fx-border-width: 1;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0">
                    <Label fx:id="lblNbConsultations" style="-fx-font-size: 30px; -fx-font-weight: bold;                                   -fx-text-fill: #1e3a5f;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Consultations" />
                </VBox>
            </HBox>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Total enregistrees" />
        </VBox>

        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12;                      -fx-padding: 20; -fx-border-color: #fecaca;                      -fx-border-radius: 12; -fx-border-width: 1;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0">
                    <Label fx:id="lblNbFactures" style="-fx-font-size: 30px; -fx-font-weight: bold;                                   -fx-text-fill: #1e3a5f;" text="0" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Factures" />
                </VBox>
            </HBox>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Non payees" />
        </VBox>

    </HBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">

        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;                      -fx-padding: 18; -fx-border-color: #e2e8f0;                      -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;                           -fx-text-fill: #1e3a5f;" text="Vos Rendez-vous du jour" />
            <TableView fx:id="tableRdvJour" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRdvPatient" prefWidth="160" text="Patient" />
                    <TableColumn fx:id="colRdvMedecin" prefWidth="160" text="Medecin" />
                    <TableColumn fx:id="colRdvHeure" prefWidth="100" text="Heure" />
                    <TableColumn fx:id="colRdvStatut" prefWidth="100" text="Statut" />
                </columns>
                <placeholder><Label text="Aucun rendez-vous aujourd'hui" /></placeholder>
            </TableView>
        </VBox>

        <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;                      -fx-padding: 18; -fx-border-color: #e2e8f0;                      -fx-border-radius: 12; -fx-border-width: 1;">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;                           -fx-text-fill: #1e3a5f;" text="  Medecins" />
            <ListView fx:id="listeMedecins" VBox.vgrow="ALWAYS" />
        </VBox>

    </HBox>

</VBox>
