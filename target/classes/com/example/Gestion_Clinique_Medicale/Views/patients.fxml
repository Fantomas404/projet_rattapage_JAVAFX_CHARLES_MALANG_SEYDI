<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.Gestion_Clinique_Medicale.Controller.PatientController">
    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>

    <Label text="Gestion des Patients"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" prefWidth="280.0"
                   promptText="Rechercher un patient..."
                   style="-fx-padding: 8; -fx-border-color: #bfdbfe;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-background-color: white;"/>
        <Button text="Rechercher" onAction="#rechercherPatient"
                style="-fx-background-color: #2563eb; -fx-text-fill: white;
                       -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nouveau Patient" onAction="#ouvrirFormulaireAjout"
                style="-fx-background-color: #1d4ed8; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 20;
                       -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="tablePatients" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"        text="ID"        prefWidth="50"/>
            <TableColumn fx:id="colNom"       text="Nom"       prefWidth="180"/>
            <TableColumn fx:id="colPrenom"    text="Prénom"    prefWidth="180"/>
            <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="150"/>
        </columns>
        <placeholder><Label text="Aucun patient trouvé"/></placeholder>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Modifier" onAction="#modifierPatient"
                style="-fx-background-color: #0ea5e9; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 20;
                       -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Button text="Supprimer" onAction="#supprimerPatient"
                style="-fx-background-color: #64748b; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 20;
                       -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>
</VBox>